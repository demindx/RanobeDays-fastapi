@startuml RanobeDaysDatabase

!theme plain
hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 12
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

title RanobeDays — database schema

entity users {
  * id : integer <<PK>>
  --
  login : varchar(50) <<UQ, IDX>>
  email : varchar(100) <<UQ, IDX>>
  password_hash : varchar(256)
  role : userrole
  is_active : boolean
  is_verified : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity user_profiles {
  * id : integer <<PK>>
  --
  user_id : integer <<FK>>
  nickname : varchar
  readed_chapters : integer
  created_at : timestamptz
  updated_at : timestamptz
}

entity refresh_sessions {
  * id : uuid <<PK>>
  --
  refresh_token : uuid <<IDX>>
  expires_in : integer
  user_id : integer <<FK>>
  created_at : timestamptz
  updated_at : timestamptz
}

entity teams {
  * id : integer <<PK>>
  --
  name : varchar(255)
  type : teamtype
  creator_id : integer <<FK>>
  is_verified : boolean
}

entity team_users {
  * user_id : integer <<PK, FK>>
  * team_id : integer <<PK, FK>>
  --
  role : teamuserrole
}

entity novels {
  * id : integer <<PK>>
  --
  title : varchar(255)
  slug : varchar(255)
  cover_path : varchar(255)
  team_id : integer <<FK>>
  language_id : integer <<FK>>
  country_id : integer <<FK>>
  embedding : vector
  description : text
  publish_date : timestamptz
  type : noveltype
  status : novelstatus
  age_limit : integer
  is_approved : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity chapters {
  * id : integer <<PK>>
  --
  title : varchar(100)
  number : integer
  content : text
  is_published : boolean
  novel_id : integer <<FK>>
  team_id : integer <<FK>>
  created_at : timestamptz
  updated_at : timestamptz
}

entity languages {
  * id : integer <<PK>>
  --
  name : varchar(100)
}

entity countries {
  * id : integer <<PK>>
  --
  name : varchar(100)
}

entity categories {
  * id : integer <<PK>>
  --
  name : varchar
  type : categorytype
}

entity novel_categories {
  * novel_id : integer <<PK, FK>>
  * category_id : integer <<PK, FK>>
}

entity bookmarks {
  * id : integer <<PK>>
  --
  user_id : integer <<FK>>
  name : varchar(150)
  is_public : boolean
}

entity bookmark_novels {
  * novel_id : integer <<PK, FK>>
  * bookmark_id : integer <<PK, FK>>
  created_at : timestamptz
  updated_at : timestamptz
}

users ||--o| user_profiles : has
users ||--o{ refresh_sessions : owns
users ||--o{ teams : creates
users ||--o{ team_users : joins
teams ||--o{ team_users : contains
teams ||--o{ novels : publishes
teams ||--o{ chapters : translates
languages ||--o{ novels : source language
countries ||--o{ novels : translation country
novels ||--o{ chapters : contains
novels ||--o{ novel_categories : tagged
categories ||--o{ novel_categories : classifies
users ||--o{ bookmarks : creates
bookmarks ||--o{ bookmark_novels : contains
novels ||--o{ bookmark_novels : saved in

note right of user_profiles
  Logical one-to-one relation.
  user_id is not currently unique
  at the database level.
end note

note bottom of novels
  Requires PostgreSQL pgvector extension.
  Enum types are generated by SQLAlchemy/Alembic.
end note

@enduml
