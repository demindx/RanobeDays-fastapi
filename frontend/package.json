{
  "name": "ranobeday-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "analyze": "VITE_BUNDLE_ANALYZE=true vite build",
    "lighthouse:mobile": "bun run build && node scripts/run-lighthouse-check.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^2.2.8",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "lighthouse": "^12.3.0",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass-embedded": "^1.97.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
